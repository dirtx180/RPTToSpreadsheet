Control="CMSPush",,{
  Info=22,64,80,25,40000001H
  Id=505
  Name="_HSF_BTTN_GN"
  Prompt="&General"
  UsAc=7FFFH
  UsPm=FFFFH
  UsCh=1000H
  Script="Sub Click()\r\n  Const sSECTION_GENERAL As String = \"GN\"\r\n  Const sSECTION_COVER_LETTER As String = \"CL\"\r\n  Const sSECTION_TIME_SUMMARY As String = \"TS\"\r\n  Const sSECTION_TIME_DETAIL As String = \"TD\"\r\n  Const sSECTION_DISB_SUMMARY As String = \"DS\"\r\n  Const sSECTION_DISB_DETAIL As String = \"DD\"\r\n\r\n  Dim hField As Fields\r\n\r\n  ' Obtain object handle.\r\n  Set hField = ThisField.ParentForm.Fields\r\n\r\n  Call SectionArea(hField, sSECTION_GENERAL)\r\n\r\n  ' Release object handle.\r\n  Set hField = Nothing\r\nEnd Sub\r\n"
}
Control="CMSPush",,{
  Info=30,786,126,25,40000001H
  Id=616
  Name="_HSF_BTTN_GN_AP_MA"
  Prompt="&Apply to all Matters"
  UsAc=7FFFH
  UsPm=FFFFH
  UsCh=1000H
  Script="Sub Click()\r\n  Dim hField As Fields\r\n\r\n  Dim strClientCode As String\r\n  Dim strOptUno As String\r\n  Dim nResponse As Integer\r\n  Dim strMsg As String\r\n  Dim strRecCount As String\r\n\r\n  Dim strSQL As String\r\n  Dim hSQL As New SQLAccess\r\n\r\n  ' Obtain object handle.\r\n  Set hField = ThisField.ParentForm.Fields\r\n\r\n  ' Obtain client code and option key.\r\n  strOptUno = Trim$(hField(\"OPT_UNO\").Value)\r\n  strClientCode = Trim$(hField(\"_HSF_CLIENT_CODE\").Value)\r\n\r\n  ' Determine if client code is provided.\r\n  If strClientCode <> \"\" Then\r\n    ' Find number of matters that will be affected.\r\n    strSQL = \"SELECT COUNT(*) AS MATTER_COUNT\"\r\n    strSQL = strSQL + \" FROM HBM_MATTER M INNER JOIN TBM_MATTER TM\"\r\n    strSQL = strSQL + \" ON M.MATTER_UNO = TM.MATTER_UNO INNER JOIN HBM_CLIENT C\"\r\n    strSQL = strSQL + \" ON M.CLIENT_UNO = C.CLIENT_UNO\"\r\n    strSQL = strSQL + \" WHERE C.CLIENT_CODE = '\" + strClientCode + \"'\"\r\n\r\n    ' Execute SQL statement.\r\n    hSQL.IssueCommand strSQL\r\n\r\n    strRecCount = hSQL.Value(\"MATTER_COUNT\")\r\n\r\n    ' Build and display message for user confirmation.\r\n    strMsg = \"You are about to update \" + strRecCount + \" active and inactive matters with the current option settings. Do you wish to proceed?\"\r\n    nResponse = YesNoMessage(strMsg)\r\n\r\n    ' Determine user response.\r\n    If nResponse = BUTTON_YES Then\r\n      ' User confirmed overwriting, thus set the matters option setting to the client.\r\n      strSQL = \"UPDATE TM\"\r\n      strSQL = strSQL + \" SET OPT_UNO = \" + strOptUno\r\n      strSQL = strSQL + \" FROM HBM_MATTER M INNER JOIN TBM_MATTER TM\"\r\n      strSQL = strSQL + \" ON M.MATTER_UNO = TM.MATTER_UNO INNER JOIN HBM_CLIENT C\"\r\n      strSQL = strSQL + \" ON M.CLIENT_UNO = C.CLIENT_UNO\"\r\n      strSQL = strSQL + \" WHERE C.CLIENT_CODE = '\" + strClientCode + \"'\"\r\n\r\n      ' Execute SQL statement.\r\n      hSQL.IssueCommand strSQL\r\n    End If    \r\n  End If\r\n\r\n  ' Release object handle.\r\n  Set hField = Nothing\r\n  Set hSQL = Nothing\r\nEnd Sub\r\n"
}
