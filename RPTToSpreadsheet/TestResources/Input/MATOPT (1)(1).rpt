  Id=619
  Name="_HSF_GN_LANG_CODE"
  Prompt="Language Code"
  UsAc=7FFFH
  UsPm=FFFFH
  UsCh=1000H
  Script="Function Validate() As Integer\r\n  Const sDEFAULT_LANGUAGE_CODE As String = \"EN\"\r\n\r\n  Dim hField As Fields\r\n\r\n  ' Obtain object handle.\r\n  Set hField = ThisField.ParentForm.Fields\r\n\r\n  ' Set the default language if none was selected.\r\n  If Trim$(hField(\"_HSF_GN_LANG_CODE\").Value) = \"\" Then\r\n    ' No language code selected, thus set to default.\r\n    hField(\"_HSF_GN_LANG_CODE\").Value = sDEFAULT_LANGUAGE_CODE\r\n  End If\r\n  \r\n  ' Release object handle.\r\n  Set hField = Nothing\r\n\r\n  Validate = TRUE\r\nEnd Function"
