Control="CMSPush",,{
  Info=322,720,69,21,40000001H
  Id=625
  Name="_HSF_BTTN_GN_CP_MA"
  Prompt="Co&py"
  UsAc=7FFFH
  UsPm=FFFFH
  UsCh=1000H
  Script="Public gstrCmdExe As String\r\nPublic gstrBillMUno As String\r\n\r\nSub Click()\r\n  Const sFROM_CLIENT As String = \"TBMCLNT\"\r\n  Const sFROM_MATTER As String = \"TBMMATT3\"\r\n\r\n  Dim hField As Fields\r\n  Dim hSQL As New SQLAccess\r\n  Dim strSQL As String\r\n\r\n  Dim strFromMatterCode As String\r\n  Dim strToMatterCode As String\r\n\r\n  Dim strMsg As String\r\n  Dim nResponse As String\r\n\r\n  ' Obtain object handle.\r\n  Set hField = ThisField.ParentForm.Fields\r\n\r\n  ' Obtain matter codes.\r\n  strToMatterCode = Trim$(hField(\"_HSF_MATTER_CODE\").Value)\r\n  strFromMatterCode = Trim$(hField(\"_HSF_GN_CP_MA\").Value)\r\n\r\n  ' Determine if a copy matter code is provided.\r\n  If (strFromMatterCode <> \"\" And strToMatterCode <> \"\") Then\r\n    ' Obtain confirmation from user.\r\n    ' Build and display confirmation.\r\n    strMsg = \"You are about to copy option settings from another matter (\" + strFromMatterCode + \") to the existing matter\"\r\n\r\n    ' Determine where the screen is launched from and set the header information.\r\n    If (gstrCmdExe <> sFROM_CLIENT And gstrCmdExe <> sFROM_MATTER) Then\r\n      ' Calling from the billing desktop.\r\n      ' Determine if a matter billing key is provided.\r\n      If gstrBillMUno <> \"\" Then\r\n        strMsg = strMsg + \" and to the existing bill\"\r\n      End If\r\n    End If  ' Matter Billing Provided Check\r\n\r\n    strMsg = strMsg + \". This WILL overwrite the current option settings permanently. Do you wish to continue?\"\r\n\r\n    nResponse = YesNoMessage(strMsg)\r\n\r\n    ' Determine user response.\r\n    If nResponse = BUTTON_YES Then\r\n      ' User confirms that option will be overwritten.\r\n      strSQL = \"EXECUTE usp_HSF_Copy_Option_Setting\"\r\n      strSQL = strSQL + \" @strFromMatterCode = '\" + strFromMatterCode + \"',\"\r\n\r\n      ' Determine where the screen is launched from and set the header information.\r\n      If (gstrCmdExe <> sFROM_CLIENT And gstrCmdExe <> sFROM_MATTER) Then\r\n        ' Calling from the billing desktop.\r\n        ' Determine if a matter billing key is provided.\r\n        If gstrBillMUno <> \"\" Then\r\n          strSQL = strSQL + \" @strApplyToInvoice = 'Y',\"\r\n          strSQL = strSQL + \" @nBillMUno = \" + gstrBillMUno + \",\"\r\n        End If\r\n      End If  ' Matter Billing Provided Check\r\n\r\n      strSQL = strSQL + \" @strToMatterCode = '\" + strToMatterCode + \"'\"\r\n\r\n      ' Execute SQL statement.\r\n      hSQL.IssueCommand strSQL\r\n\r\n      strMsg = hSQL.Value(\"RETURN_VALUE\")\r\n\r\n      ' Determine the return code.\r\n      If CLng(hSQL.Value(\"RETURN_CODE\")) <> 0 Then\r\n        ' Error occur.\r\n        ErrorMessage strMsg\r\n      Else\r\n        ' No error occur in the copy process.\r\n        InfoMessage strMsg\r\n\r\n        ' Automatically cancel screen any changes - click CANCEL button.\r\n        SendKeysUAC \"%C\"\r\n      End If\r\n    End If  ' User Response Check\r\n  Else\r\n    ' Either From or To matter is not provided, thus display error message.\r\n    strMsg = \"A matter code has not been provided. Please provide a matter code and try again.\"\r\n\r\n    ErrorMessage strMsg\r\n  End If  ' Launch From Billing Desktop Check\r\n \r\n  ' Release object handle.\r\n  Set hField = Nothing\r\n  Set hSQL = Nothing\r\nEnd Sub\r\n"
}
