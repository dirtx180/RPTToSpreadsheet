Control="CMSPush",,{
  Info=484,257,30,25,40000001H
  Id=581
  Name="_HSF_BTTN_DS_ADD"
  Prompt=">>"
  UsAc=7FFFH
  UsPm=FFFFH
  UsCh=1000H
  Script="Sub Click()\r\n  Const sSECTION_DISB_SUMMARY As String = \"DS\"\r\n\r\n  Dim hSourceList As List\r\n  Dim hDestinationList As List\r\n  Dim hField As Fields\r\n  Dim strData As String\r\n\r\n  Set hField = ThisField.ParentForm.Fields\r\n  Set hSourceList = hField(\"_HSF_LST_DS_AVAIL\").List\r\n  Set hDestinationList = hField(\"_HSF_LST_DS_INCL\").List\r\n\r\n  ' Set included list.\r\n  Call AllocateDeallocateIncludeList(hSourceList, hDestinationList, sSECTION_DISB_SUMMARY)\r\n\r\n  ' Rebuild and set item list.\r\n  strData = MakeIncludeString(hDestinationList, sSECTION_DISB_SUMMARY)\r\n  hField(\"_HSF_DS_LIST_ITEM\").Value = strData\r\n\r\n  ' Reset handles.\r\n  Set hField = Nothing\r\n  Set hSourceList = Nothing\r\n  Set hDestinationList = Nothing\r\nEnd Sub\r\n\r\n"
